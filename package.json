{
    "name": "@snowui-design-system/resource-svelte",
    "version": "1.0.30",
    "description": "A lightweight Svelte component package that automatically generates icon, avatar, background, and other components from processed assets in @snowui-design-system/resource-base.",
    "license": "SEE LICENSE IN PACKAGE_LICENSE.md",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "svelte": "./src/index.ts",
    "exports": {
        ".": {
            "svelte": "./src/index.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "pnpm license:manifest && pnpm license:check:structure && tsup",
        "generate": "tsx scripts/generate-svelte.ts",
        "license:manifest": "node scripts/resource-license-manifest.mjs",
        "license:check:structure": "node scripts/resource-license-manifest.mjs --check",
        "license:check": "node scripts/resource-license-manifest.mjs --check --publication",
        "prepublishOnly": "pnpm build && pnpm license:check"
    },
    "dependencies": {
        "@snowui-design-system/resource-base": "^1.0.29"
    },
    "peerDependencies": {
        "svelte": "^4.0.0 || ^5.0.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "svelte": "^5.0.0",
        "tsup": "^8.0.0",
        "tsx": "^4.7.0",
        "typescript": "^5.0.0"
    }
}
